# Copy to backend/.env if needed. Never put API keys in this file: .env rejects unknown
# keys, and keys belong in Settings (Windows Credential Manager).
# DEEPTRACE_MODE: mock (default), offline, or live_free (opt-in, see docs/M1_HANDOFF.md).
DEEPTRACE_MODE=mock
DEEPTRACE_ALLOW_PAID_APIS=false
# Required only for live_free: your verified free-tier Gemini model ID.
# DEEPTRACE_LLM_MODEL=
DEEPTRACE_HOST=127.0.0.1
DEEPTRACE_PORT=8000
DEEPTRACE_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
# Optional absolute local directory. Default: %LOCALAPPDATA%\DeepTraceAI
# DEEPTRACE_DATA_DIR=C:/Users/YOUR_NAME/AppData/Local/DeepTraceAI
